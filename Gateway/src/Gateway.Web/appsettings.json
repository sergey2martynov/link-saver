{
  "Jwt": {
    "Key": "change-me-to-a-random-secret-at-least-32-chars"
  },
  "Telegram": {
    "BotToken": ""
  },
  "Services": {
    "UserService": "http://userservice"
  },
  "ReverseProxy": {
    "Routes": {
      "links-route": {
        "ClusterId": "linkservice",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/links/{**catch-all}"
        }
      },
      "tags-route": {
        "ClusterId": "linkservice",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/tags/{**catch-all}"
        }
      },
      "links-hub-route": {
        "ClusterId": "linkservice",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/hubs/links/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "userservice",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "linkservice": {
        "Destinations": {
          "d1": { "Address": "http://linkservice" }
        }
      },
      "userservice": {
        "Destinations": {
          "d1": { "Address": "http://userservice" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
